{
  "manifest_version": 3,
  "name": "OCR Clipper",
  "version": "0.1.0",
  "description": "滚动截屏 + 本机智能体 OCR，自动翻页，导出 EPUB / PDF / TXT / Markdown / HTML",
  "key": "",
  "permissions": [
    "sidePanel",
    "tabs",
    "scripting",
    "storage",
    "unlimitedStorage",
    "nativeMessaging",
    "downloads",
    "debugger"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "OCR Clipper"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
